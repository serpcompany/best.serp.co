# Per-worktree harness state, logs, browser profiles, and evidence
.runtime/

# One-time JSON -> D1 import artifacts (~70 MB). Regenerate deterministically with
# `pnpm migration:generate` from json-directory-template@25e2a8d. The parity report and
# a brotli copy of the combined SQL (seeds local D1 and CI) are committed.
d1/artifacts/*
!d1/artifacts/*-parity.yaml
!d1/artifacts/*.sql.br

