# Workers static assets header rules (not served as a file). Static files are answered before
# the Worker runs, so the Worker's non-production X-Robots-Tag never reaches them; keep every
# *.workers.dev host's files, and staging's canonical host's, out of search indexes too. See
# docs/architecture.md, "Environments and hosts".
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex, nofollow

https://staging.best.serp.co/*
  X-Robots-Tag: noindex, nofollow
