{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "build": "NODE_NO_WARNINGS=1 next build",
    "build:worker": "NODE_NO_WARNINGS=1 opennextjs-cloudflare build",
    "clean": "git clean -xdf .cache .turbo .next coverage node_modules",
    "dev": "next dev --webpack --port ${PORT:-3005}",
    "dev:inspect": "NODE_OPTIONS='--inspect' next dev --webpack --port ${PORT:-3005}",
    "preview:worker": "pnpm --dir=../.. tsx scripts/d1-local-preview.ts",
    "report": "playwright show-report",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/public-parity.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts --project=chromium",
    "test:install": "playwright install chromium",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@content-collections/core": "^0.8.2",
    "@content-collections/next": "^0.2.10",
    "@icons-pack/react-simple-icons": "^12.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@opennextjs/cloudflare": "1.20.6",
    "@sentry/nextjs": "^10.76.0",
    "@t3-oss/env-nextjs": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "geist": "^1.7.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.12",
    "lucide-react": "^0.486.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "parse5": "7.3.0",
    "radix-ui": "1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tldts": "7.4.16",
    "tw-animate-css": "1.4.0",
    "undici": "7.29.1",
    "vaul": "^1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@next/bundle-analyzer": "16.3.8",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
