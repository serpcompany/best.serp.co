{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "build": "NODE_NO_WARNINGS=1 next build",
    "build:worker": "NODE_NO_WARNINGS=1 opennextjs-cloudflare build",
    "clean": "git clean -xdf .cache .turbo .next coverage node_modules",
    "dev": "next dev --webpack --port ${PORT:-3005}",
    "dev:inspect": "NODE_OPTIONS='--inspect' next dev --webpack --port ${PORT:-3005}",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "preview:worker": "pnpm --dir=../.. tsx scripts/d1-local-preview.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@content-collections/core": "^0.8.2",
    "@content-collections/next": "^0.2.10",
    "@icons-pack/react-simple-icons": "^12.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@opennextjs/cloudflare": "1.20.6",
    "@serpdirectory/config-next": "workspace:*",
    "@serpdirectory/config-typescript": "workspace:*",
    "@serpdirectory/content": "workspace:*",
    "@serpdirectory/data-ops": "workspace:*",
    "@serpdirectory/design-system": "workspace:*",
    "@serpdirectory/logging": "workspace:*",
    "@serpdirectory/site-config": "workspace:*",
    "@serpdirectory/utils": "workspace:*",
    "@serpdirectory/web-core": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.5",
    "jose": "6.2.12",
    "lucide-react": "^0.486.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "parse5": "7.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "catalog:",
    "sonner": "^2.0.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "4.147.0"
  }
}
