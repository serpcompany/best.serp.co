{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "best-serp-co-local",
  "main": "worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "D1_RUNTIME_ENV": "local",
    "MEDIA_BASE_URL": "/_media",
    "SITE_ENVIRONMENT": "local"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "best-serp-co-media-local"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["0 * * * *", "15 3 * * 1", "45 3 * * *", "*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "best-serp-co-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../d1/drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "best-serp-co-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://best-serp-co-staging.serpcompany.workers.dev",
        "BETTER_AUTH_URL": "https://best-serp-co-staging.serpcompany.workers.dev",
        "CF_ACCESS_AUD": "",
        "CF_ACCESS_REQUIRED": "off",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "D1_RUNTIME_ENV": "staging",
        "EMAIL_STAGING_ALLOWLIST": "devin@serp.co",
        "MEDIA_BASE_URL": "https://cdn-staging.serp.co",
        "SITE_ENVIRONMENT": "staging",
        "USESEND_BASE_URL": "https://app.usesend.com"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "triggers": {
        "crons": ["0 * * * *", "15 3 * * 1", "45 3 * * *", "*/15 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "best-serp-co-staging",
          "database_id": "8e6b67e5-9c58-4fa9-aca1-25b0020c0833",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cdn-staging"
        }
      ]
    },
    "production": {
      "name": "best-serp-co-production",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://best.serp.co",
        "BETTER_AUTH_URL": "https://best.serp.co",
        "CANONICAL_HOST_REDIRECT": "on",
        "CF_ACCESS_AUD": "a30cbc5f875dd674644be917d50cce67c69747eccc127b8bb1a02d226c8b2491",
        "CF_ACCESS_TEAM_DOMAIN": "serpcompany.cloudflareaccess.com",
        "D1_RUNTIME_ENV": "production",
        "MEDIA_BASE_URL": "https://cdn.serp.co",
        "SITE_ENVIRONMENT": "production",
        "USESEND_BASE_URL": "https://app.usesend.com"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "triggers": {
        "crons": ["0 * * * *", "15 3 * * 1", "45 3 * * *", "*/15 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "best-serp-co-production",
          "database_id": "404ec437-53a2-4fbc-8b5f-b5e69065708e",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cdn"
        }
      ]
    }
  }
}
