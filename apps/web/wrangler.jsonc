{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "best-serp-co-local",
  "main": "worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "D1_RUNTIME_ENV": "local",
    "SITE_ENVIRONMENT": "local"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "best-serp-co-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../d1/drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "best-serp-co-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "AUTH_TRUST_HOST": "true",
        "D1_RUNTIME_ENV": "staging",
        "SITE_ENVIRONMENT": "staging"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "best-serp-co-staging",
          "database_id": "8e6b67e5-9c58-4fa9-aca1-25b0020c0833",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ]
    },
    "production": {
      "name": "best-serp-co-production",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "AUTH_TRUST_HOST": "true",
        "CANONICAL_HOST_REDIRECT": "off",
        "D1_RUNTIME_ENV": "production",
        "SITE_ENVIRONMENT": "production"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "best-serp-co-production",
          "database_id": "404ec437-53a2-4fbc-8b5f-b5e69065708e",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ]
    }
  }
}
