{
  "name": "best.serp.co",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check:links": "lychee --config ./lychee.toml --verbose .",
    "clean": "git clean -xdf node_modules dist .next",
    "clean:workspaces": "turbo clean",
    "dev": "pnpm worker:preview",
    "dev:all": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "docs:check": "pnpm tsx scripts/harness/docs-health.ts",
    "docs:garden": "pnpm docs:check && pnpm exec vitest run scripts/architecture-guard.test.ts",
    "harness:fast": "pnpm tsx scripts/harness/runner.ts fast",
    "harness:check": "pnpm tsx scripts/harness/runner.ts full",
    "validate": "pnpm harness:check",
    "agent:dev": "pnpm tsx scripts/harness/agent-runtime.ts dev",
    "agent:doctor": "pnpm tsx scripts/harness/agent-runtime.ts doctor",
    "agent:manifest": "pnpm tsx scripts/harness/agent-runtime.ts manifest",
    "agent:logs": "pnpm tsx scripts/harness/agent-runtime.ts logs",
    "agent:evidence": "pnpm tsx scripts/harness/agent-runtime.ts evidence",
    "agent:ui:capture": "pnpm tsx scripts/harness/ui-capture.ts",
    "catalog:claim-holds": "pnpm tsx scripts/claim-holds-manifest.ts",
    "catalog:domains": "pnpm tsx scripts/listing-domain-check.ts",
    "catalog:faqs": "pnpm tsx scripts/listing-faq-move.ts",
    "worktree:new": "pnpm tsx scripts/harness/worktree.ts new",
    "worktree:init": "pnpm tsx scripts/harness/worktree.ts init",
    "worktree:doctor": "pnpm tsx scripts/harness/worktree.ts doctor",
    "worktree:destroy": "pnpm tsx scripts/harness/worktree.ts destroy",
    "migration:preflight": "pnpm tsx scripts/migration/preflight.ts",
    "migration:legacy-media": "pnpm tsx scripts/migration/legacy-media.ts",
    "migration:generate": "pnpm tsx scripts/migration/generate-initial-artifact.ts",
    "db:generate": "pnpm exec drizzle-kit generate --config drizzle.config.ts",
    "db:migrations:list:local": "pnpm tsx scripts/d1-local-guard.ts list",
    "db:migrate:local": "pnpm tsx scripts/d1-local-guard.ts migrate",
    "db:import:local": "pnpm tsx scripts/d1-local-guard.ts import",
    "db:verify:local": "pnpm tsx scripts/d1-local-guard.ts verify",
    "db:publish:local": "pnpm tsx scripts/d1-local-guard.ts publish",
    "db:migrations:list:staging": "pnpm tsx scripts/cloudflare-release.ts list-migrations staging",
    "db:migrate:staging": "pnpm tsx scripts/cloudflare-release.ts migrate staging",
    "db:migrations:list:production": "pnpm tsx scripts/cloudflare-release.ts list-migrations production",
    "db:migrate:production": "pnpm tsx scripts/cloudflare-release.ts migrate production",
    "release:promote": "pnpm tsx scripts/release-promote.ts",
    "db:publish:production": "pnpm tsx scripts/d1-remote-publisher.ts",
    "db:publish:staging": "pnpm tsx scripts/d1-remote-publisher.ts --staging",
    "media:health": "pnpm tsx scripts/media-health.ts",
    "media:health:issue": "pnpm tsx scripts/media-health-issue.ts",
    "media:upload:dry-run": "pnpm tsx scripts/media-upload.ts --target=staging --dry-run",
    "media:upload:production": "pnpm tsx scripts/media-upload.ts --target=production",
    "media:upload:staging": "pnpm tsx scripts/media-upload.ts --target=staging",
    "format": "biome check --write .",
    "worker:build": "pnpm --filter web build:worker",
    "worker:preview": "pnpm tsx scripts/d1-local-guard.ts preview",
    "audit:sitemaps": "pnpm tsx scripts/audit-sitemaps.ts",
    "security:audit:production": "pnpm tsx scripts/production-dependency-audit.ts",
    "generate:badges": "tsx scripts/generate-badges.ts",
    "inventory:badges": "node scripts/inventory-featured-badges.mjs",
    "inventory:r2-badges": "node scripts/inventory-r2-featured-badges.mjs",
    "qc:badges": "pnpm exec vitest run scripts/featured-badge-assets.test.ts scripts/featured-badge-r2-assets.test.ts",
    "r2:sync-badges": "node scripts/sync-featured-badges-r2.mjs",
    "postinstall": "manypkg fix",
    "lint": "pnpm lint:forbidden-links && turbo lint && manypkg check",
    "lint:fix": "turbo lint:fix && manypkg fix && pnpm biome lint --write .",
    "lint:forbidden-links": "node scripts/lint-forbidden-links.mjs",
    "audit:forbidden-links": "node scripts/lint-forbidden-links.mjs --generated",
    "shadcn": "cd apps/web && pnpm dlx shadcn@canary add",
    "start": "turbo run start",
    "test": "turbo test --cache-dir=.turbo",
    "test:d1": "pnpm exec vitest run scripts/d1-drizzle-local.test.ts scripts/d1-workerd-plans.test.ts scripts/d1-workerd-queries.test.ts scripts/d1-local-state.test.ts scripts/d1-preview-http-gates.test.ts scripts/d1-publisher.sqlite.test.ts scripts/d1-remote-publisher.test.ts scripts/cloudflare-release.test.ts scripts/staging-verification.test.ts scripts/release-promote.test.ts scripts/listing-domain-check.test.ts scripts/media-upload.test.ts scripts/catalog-media.test.ts scripts/d1-compat.test.ts scripts/r2-objects.test.ts scripts/media-health.test.ts",
    "test:e2e": "turbo test:e2e --filter=e2e",
    "test:e2e:smoke": "turbo test:e2e:smoke --filter=e2e",
    "test:e2e:ui": "turbo test:e2e:ui --filter=e2e",
    "test:e2e:debug": "turbo test:e2e:debug --filter=e2e",
    "test:repo": "pnpm exec vitest run scripts/architecture-guard.test.ts scripts/wrangler-config.test.ts scripts/e2e-console-guard.test.ts scripts/harness-docs.test.ts scripts/harness/biome-changed.test.ts scripts/migration-preflight.test.ts scripts/migration/compare-pages.test.ts scripts/migration/legacy-media.test.ts scripts/worktree-harness.test.ts scripts/pr-review-workflow.test.ts scripts/main-validation-workflow.test.ts scripts/deploy-workflows.test.ts scripts/security-automation.test.ts scripts/production-dependency-audit.test.ts scripts/labels-workflow.test.ts scripts/ci-workflow-install.test.ts scripts/ci-runner-workflows.test.ts scripts/next-config-build-id.test.ts scripts/network-brands.test.ts scripts/about-page-brand-content.test.ts scripts/audit-sitemaps.test.ts scripts/submit-gsc-sitemaps.test.ts scripts/eslint-rules/no-forbidden-listing-links.test.ts scripts/footer-dr-badge.test.ts scripts/featured-badge-assets.test.ts scripts/featured-badge-r2-assets.test.ts scripts/listing-logo-fallback-asset.test.ts scripts/listing-image-guard.test.ts apps/web/src/lib apps/web/src/components apps/web/src/hooks",
    "test:watch": "turbo test:watch --cache-dir=.turbo",
    "typecheck": "turbo typecheck",
    "update": "pnpm update -r",
    "migration:compare": "pnpm tsx scripts/migration/compare-pages.ts",
    "preview": "pnpm tsx scripts/d1-local-guard.ts preview",
    "worker:config:validate": "pnpm tsx scripts/d1-local-config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@manypkg/cli": "^0.23.0",
    "@serpdirectory/data-ops": "workspace:*",
    "@serpdirectory/utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.4.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.1",
    "tsx": "catalog:",
    "turbo": "^2.8.7",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "import-in-the-middle": "^1.14.2",
      "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    }
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24"
  }
}
