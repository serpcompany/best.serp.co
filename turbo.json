{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "E2E_VISUAL",
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:e2e:smoke": {
      "cache": false,
      "env": [
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:e2e:fast": {
      "cache": false,
      "env": [
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:e2e:ui": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "E2E_VISUAL",
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:e2e:debug": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "E2E_VISUAL",
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:e2e:headed": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "E2E_VISUAL",
        "E2E_WORKERS",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER_COMMAND"
      ]
    },
    "test:install": {
      "cache": false
    },
    "test:related": {
      "cache": false
    }
  }
}
